{
  "name": "memem",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "pretest": "npm run build:client",
    "test": "vitest run",
    "pretest:core": "npm run build:client",
    "test:core": "vitest run --project core",
    "pretest:worker": "npm run build:client",
    "test:worker": "vitest run --project worker",
    "precoverage": "npm run build:client",
    "coverage": "vitest run --coverage && npm run e2e",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "precheck": "npm run build:client",
    "check": "tsc --noEmit",
    "build:client": "node scripts/build-client.mjs",
    "demo": "node examples/local.ts",
    "dev": "wrangler dev",
    "deploy": "bash scripts/deploy-cloudflare.sh",
    "acceptance:remote": "node scripts/remote-acceptance.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.28.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261009.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/client-current": "npm:@modelcontextprotocol/client@^2.3.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "4.1.11",
    "ast-v8-to-istanbul": "1.0.7",
    "esbuild": "0.28.2",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  }
}
